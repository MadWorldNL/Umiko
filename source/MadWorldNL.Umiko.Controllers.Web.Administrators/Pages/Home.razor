@page "/"

<PageTitle>Dashboard - Umiko Admin</PageTitle>

<h1>Dashboard</h1>
<p>Welcome to the Umiko administration panel.</p>

<div class="dashboard-grid">
    <div class="card">
        <h3>Users</h3>
        <p class="card-value">0</p>
    </div>
    <div class="card">
        <h3>Active Sessions</h3>
        <p class="card-value">0</p>
    </div>
    <div class="card">
        <h3>System Status</h3>
        <p class="card-value status-ok">Online</p>
    </div>
</div>